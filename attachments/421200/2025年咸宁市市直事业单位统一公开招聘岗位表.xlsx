<script>
    var aaa='';
	zcwj(aaa);
	function zcwj(aaa){
		$.ajax({
			type:'GET',
		   url:'//rst.hubei.gov.cn/zfxxgk/zc/zcjd/list.json',
			dataType : "json",
			success : function(datas) {
				var data=datas.data;
				//console.log(data);
				//console.log(data.length);
				$("#wz1").html(wz1(data));
                $("#wz").html(wz(data));
                $("#tw1").html(tw1(data));
                $("#tw").html(tw(data));
                $("#yp").html(yp(data));
             //   $("#fbh").html(fbh(data));
                			  // 初始化客户端分页插件
			}
		});
	}

    
    function wz(data) {
				var zwnr='';
				var i=0;
                var j=0;
                for(var index=0; index<data.length;index++){
						var DOCTITLE = data[index].DOCTITLE;  //文字方式、图文方式、音频方式、新闻发布会方式
                        var URL = data[index].URL; 
                        var PUBDATE = data[index].PUBDATE; 
                        var DOCRELTIME = data[index].DOCRELTIME; 
                        var READINGWAY = data[index].READINGWAY; 
						i++;
						if(READINGWAY=='文字方式') {
                            j++
						 zwnr+='<li><a href="'+URL+'" target="_blank" title="'+DOCTITLE+'">'+DOCTITLE+'<span class="date">'+DOCRELTIME+'</span></a></li>'; 
                         if (j ===6) {
			            break;
		                    }
                            }
				}
				if(i == 0){
						zwnr+='<li style="text-align:center;">未找到相关数据</li>';
					}
                    return zwnr;	
 }
 function wz1(data) {
				var zwnr='';
				var i=0;
                var j=0;
                for(var index=0; index<data.length;index++){
						var DOCTITLE = data[index].DOCTITLE;  //文字方式、图文方式、音频方式、新闻发布会方式
                        var URL = data[index].URL; 
                        var PUBDATE = data[index].PUBDATE; 
                        var DOCRELTIME = data[index].DOCRELTIME; 
                        var READINGWAY = data[index].READINGWAY; 
                        var title =  READINGWAY.indexOf('文字');
					    var title1 =  READINGWAY.indexOf('音频');
						i++;
						if(title >=0 || title1 >=0){
                            j++
						 zwnr+='<li><a href="'+URL+'" target="_blank" title="'+DOCTITLE+'">'+DOCTITLE+'<span class="date">'+DOCRELTIME+'</span></a></li>'; 
                         if (j === 3) {
			            break;
		                    }
                            }


				}
				if(i == 0){
						zwnr+='<li style="text-align:center;">未找到相关数据</li>';
					}
                    return zwnr;	
 }

 function tw1(data) {
				var zwnr='';
				var i=0;
                var j=0;
                for(var index=0; index<data.length;index++){
						var DOCTITLE = data[index].DOCTITLE;  //文字方式、图文方式、音频方式、新闻发布会方式
                        var URL = data[index].URL; 
                        var PUBDATE = data[index].PUBDATE; 
                        var DOCRELTIME = data[index].DOCRELTIME; 
                        var READINGWAY = data[index].READINGWAY; 
                        var IMG = data[index].IMG; 
                        var title =  READINGWAY.indexOf('图文');
					    var title1 =  READINGWAY.indexOf('新闻发布会');
						i++;
						if(title >=0 || title1 >=0){
                            j++
						 zwnr+='<li class="col-md-6"><a href="'+URL+'" target="_blank"><img src="'+IMG+'" alt="" /><a class="picmb">'+DOCTITLE+'</a></a></li>'; 
                         if (j === 2) {
			            break;
		                    }
                            }
				}
				if(i == 0){
						zwnr+='<li style="text-align:center;">未找到相关数据</li>';
					}
                    return zwnr;	
 }

 function tw(data) {
				var zwnr='';
				var i=0;
                var j=0;
                for(var index=0; index<data.length;index++){
						var DOCTITLE = data[index].DOCTITLE;  //文字方式、图文方式、音频方式、新闻发布会方式
                        var URL = data[index].URL; 
                        var PUBDATE = data[index].PUBDATE; 
                        var DOCRELTIME = data[index].DOCRELTIME; 
                        var READINGWAY = data[index].READINGWAY; 
                        var IMG = data[index].IMG; 
						i++;
						if(READINGWAY=='图文方式') {
                            j++
						 zwnr+='<li class="col-md-6"><a href="'+URL+'" target="_blank"><img src="'+IMG+'" alt="" /><a class="picmb">'+DOCTITLE+'</a></a></li>'; 
                         if (j === 4) {
			            break;
		                    }
                            }
				}
				if(i == 0){
						zwnr+='<li style="text-align:center;">未找到相关数据</li>';
					}
                    return zwnr;	
 }
    function yp(data) {
				var zwnr='';
				var i=0;
                var j=0;
                for(var index=0; index<data.length;index++){
						var DOCTITLE = data[index].DOCTITLE;  //文字方式、图文方式、音频方式、新闻发布会方式
                        var URL = data[index].URL; 
                        var PUBDATE = data[index].PUBDATE; 
                        var DOCRELTIME = data[index].DOCRELTIME; 
                        var READINGWAY = data[index].READINGWAY; 
						i++;
						if(READINGWAY=='音频方式' || READINGWAY=='视频方式') {
                            j++
						 zwnr+='<li><a href="'+URL+'" target="_blank" title="'+DOCTITLE+'">'+DOCTITLE+'<span class="date">'+DOCRELTIME+'</span></a></li>'; 
                         if (j === 7) {
			            break;
		                    }
                            }
				}
				if(i == 0){
						zwnr+='<li style="text-align:center;">未找到相关数据</li>';
					}
                    return zwnr;	
 }
    function fbh(data) {
				var zwnr='';
				var i=0;
                var j=0;
                for(var index=0; index<data.length;index++){
						var DOCTITLE = data[index].DOCTITLE;  //文字方式、图文方式、音频方式、新闻发布会方式
                        var URL = data[index].URL; 
                        var PUBDATE = data[index].PUBDATE; 
                        var DOCRELTIME = data[index].DOCRELTIME; 
                        var READINGWAY = data[index].READINGWAY; 
                        var IMG = data[index].IMG; 
						i++;
						if(READINGWAY=='新闻发布会方式') {
                            j++
                            zwnr+='<li class="col-md-6"><a href="'+URL+'"><img src="'+IMG+'" alt="" /><a class="picmb">'+DOCTITLE+'</a></a></li>'; 
                         if (j === 4) {
			            break;
		                    }
                            }
				}
				if(i == 0){
						zwnr+='<li style="text-align:center;">未找到相关数据</li>';
					}
                    return zwnr;	
 }


jQuery(".category").slide({titCell:".hd a",mainCell:".bd",autoPlay:false});
 </script>
