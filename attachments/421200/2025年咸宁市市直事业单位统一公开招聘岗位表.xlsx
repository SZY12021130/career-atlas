              });
              //设置自动关闭时间
              //setTimeout("layer.closeAll()", 5000);
          });
    
    }
                } else if (currTime < beginTime) {//开始之前
                    //do nothing
                } else if (currTime > endTime) {//已经结束
                    //do nothing
                }
            }
            //调用函数
            bannerTimer("2022-09-30 24:00:00", "2022-10-08 00:00:00");
    });
    </script>
