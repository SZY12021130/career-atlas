              });
              //设置自动关闭时间
              //setTimeout("layer.closeAll()", 5000);
          });
    }
    //手机版
    else if(document.documentElement.clientWidth<=450){
          $(window).load(function() {
              //弹层
              layer.open({
                  type: 1, //弹自定义内容模式
                  //type: 2, //弹iframe页面模式
